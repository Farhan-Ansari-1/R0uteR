# Create a local .env file from this template. Never commit the real key.
GEMINI_API_KEY=replace_with_your_key
# Set to ollama to use the local Gemma model for report review.
ROUTER_AI_PROVIDER=gemini
# Override this only when you intentionally change models.
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=120
# Comma-separated, explicitly authorized security-lab hosts only.
ROUTER_LAB_TARGETS=localhost,127.0.0.1,::1,192.168.1.0/24,192.168.56.0/24

# Kali Linux VM Lab Connection (VMware / VirtualBox)
KALI_VM_HOST=127.0.0.1
KALI_VM_PORT=22
KALI_VM_USER=kali
KALI_VM_PASSWORD=kali
# KALI_VM_KEY_PATH=C:\Users\username\.ssh\id_rsa

# Approval Mode: 'cli' (direct terminal confirmation without Windows popups) or 'ui'
ROUTER_APPROVAL_MODE=cli
ROUTER_AUTO_APPROVE_LAB=true
